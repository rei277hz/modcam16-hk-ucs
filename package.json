{
  "name": "modcam16-hk-cartesian-picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:rust && npm run build:wasm && npm run test:ocio && npm run test:ui && npm run test:browser",
    "test:rust": "cargo test --manifest-path src/wasm/color_core/Cargo.toml",
    "test:ocio": "node --test tests/ocio_oracle.test.mjs",
    "test:ui": "node --experimental-strip-types --test tests/picker_math.test.mjs",
    "test:browser": "node --test tests/picker_browser.test.mjs",
    "build:wasm": "wasm-pack build src/wasm/color_core --target web --release --out-dir ../pkg --no-pack",
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
